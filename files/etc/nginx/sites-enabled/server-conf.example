# Example site; copy to server.conf (or any *.conf) and adjust.
#
# Image resizing itself lives in sites-enabled/1-resize.conf (shared by all
# sites, including the origin host allow-list); a site only needs to include
# /etc/nginx/resize.conf to expose /rx/<options>/<image url>.

server {
    listen 80;
    listen [::]:80 ipv6only=on;

    listen 443 ssl;
    listen [::]:443 ipv6only=on ssl;
    http2  on;

    include             /etc/nginx/include/ssl-ciphers.conf;
    ssl_certificate     /etc/nginx/ssl/dummycert.pem;
    ssl_certificate_key /etc/nginx/ssl/dummykey.pem;

    server_name                      default;
    root                             /usr/share/nginx/html;
    index                            index.html index.htm;

    location /healthcheck {
        default_type                 text/plain;
        return 200 "OK";
    }

    # image resize: /rx/<options>/<image url>
    include                          /etc/nginx/resize.conf;

    # optional: geoip lookup at /geoip/<ip> or /geoipme/
    # include                        /etc/nginx/geoipme.conf;
}
